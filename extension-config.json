{
  "version": "1.1.0",
  "id": "@shopgate-project/out-of-stock-badges",
  "components": [
    {
      "id": "ComponentProductImage",
      "type": "portals",
      "path": "frontend/portals/ComponentProductImage",
      "target": "component.product-image"
    }
  ],
  "configuration": {
    "textColor": {
      "type": "admin",
      "default": "#fff",
      "destination": "frontend",
      "params": {
        "label": "Text color of the badge",
        "type": "text"
      }
    },
    "bgColor": {
      "type": "admin",
      "default": "#FF00AF",
      "destination": "frontend",
      "params": {
        "label": "Background color of the badge",
        "type": "text"
      }
    },
    "badgeText": {
      "type": "admin",
      "default": "Sold out",
      "destination": "frontend",
      "params": {
        "label": "Text of the badge",
        "type": "text"
      }
    },
    "hideBadge": {
      "type": "admin",
      "default": false,
      "destination": "frontend",
      "params": {
        "label": "Hide the badge and only gray out the image",
        "type": "checkbox"
      }
    }
  }
}